{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/check-replies",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/send-reminders",
      "schedule": "0 18 * * *"
    }
  ]
}
